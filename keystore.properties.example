# Copy to keystore.properties (gitignored) to sign release builds.
# Create a key with:
#   keytool -genkeypair -v -keystore tricerasync-release.jks -alias tricerasync \
#           -keyalg RSA -keysize 2048 -validity 10000
storeFile=tricerasync-release.jks
storePassword=CHANGE_ME
keyAlias=tricerasync
keyPassword=CHANGE_ME
