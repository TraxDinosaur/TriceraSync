{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TriceraSync Cue Format (PCF v1)",
  "type": "object",
  "required": ["version", "video", "meta", "cues"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "video": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["youtube"]
        },
        "id": {
          "type": ["string", "null"]
        },
        "title": {
          "type": ["string", "null"]
        },
        "channel": {
          "type": ["string", "null"]
        },
        "durationMs": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["sheetVersion"],
      "properties": {
        "sheetVersion": {
          "type": "integer",
          "minimum": 1
        },
        "createdAt": {
          "type": "string"
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 240
        }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "restoreOnEnd": {
          "type": "boolean",
          "default": true
        },
        "toleranceMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "default": 120
        }
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "at", "type", "params"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c_[A-Za-z0-9]{2,}$"
          },
          "at": {
            "type": "integer",
            "minimum": 0
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "type": "string",
            "enum": ["vibrate", "brightness", "volume", "flash", "torch"]
          },
          "params": {
            "type": "object"
          }
        }
      }
    }
  }
}
