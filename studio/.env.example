# ─── Storage ────────────────────────────────────────────────────────────────
# Shipped default is file-based JSON storage (.data/studio-store.json).
# To customize the file path:
# STORAGE_FILE=.data/studio-store.json
#
# Custom adapter (e.g. your private PostgreSQL database):
# STORAGE_ADAPTER=postgres

# ─── Access Control ──────────────────────────────────────────────────────────
# Optional access token.
# - In local development (NODE_ENV != production), leaving this blank allows all
#   writes without authentication.
# - In production (NODE_ENV=production), write operations are blocked unless
#   ACCESS_TOKEN is set.
# Clients send this in `x-access-token` / `x-demo-token` or enter it at /unlock.
ACCESS_TOKEN=

# ─── Optional Integrations ───────────────────────────────────────────────────
# YouTube Data API v3 key (optional). Used only for enhanced YouTube metadata;
# title and channel already resolve via keyless oEmbed without this key.
YOUTUBE_API_KEY=

# Studio base URL (used for metadata and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public GitHub repository link
NEXT_PUBLIC_GITHUB_URL=https://github.com/TraxDinosaur/TriceraSync
